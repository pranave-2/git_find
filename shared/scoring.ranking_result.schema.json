{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://recruitment-genie/shared/scoring.ranking_result.schema.json",
  "title": "Module C.2 — Ranking Result",
  "description": "Output of the ranking scorer at JD time. Consumes Module D's retrieved evidence, aggregates per-skill across repositories (MAX), applies requirement weights from the JD, and produces the final deterministic candidate score. Genie never produces these numbers.",
  "type": "object",
  "required": ["schema_version", "job_id", "policy_version", "requirement_weights", "aggregation", "ranked_candidates", "computed_at"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "$ref": "common.schema.json#/$defs/schema_version" },
    "job_id": { "$ref": "common.schema.json#/$defs/job_id" },

    "policy_version": {
      "type": "string",
      "description": "Version of the ranking policy (weights + aggregation rule). Scores are only comparable within one policy version."
    },

    "requirement_weights": {
      "type": "object",
      "description": "Scoring policy, defined by the team, not the LLM. Importance comes from the JD's requirement language.",
      "required": ["required", "preferred", "bonus"],
      "additionalProperties": false,
      "properties": {
        "required":  { "type": "number", "minimum": 0, "default": 1.0 },
        "preferred": { "type": "number", "minimum": 0, "default": 0.6 },
        "bonus":     { "type": "number", "minimum": 0, "default": 0.3 }
      }
    },

    "aggregation": {
      "type": "string",
      "enum": ["max", "mean", "top_k_mean"],
      "default": "max",
      "description": "How multiple repositories demonstrating the same skill collapse into one candidate-level strength."
    },

    "ranked_candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rank", "student_id", "name", "score", "skill_scores", "numerator", "denominator"],
        "additionalProperties": false,
        "properties": {
          "rank": { "type": "integer", "minimum": 1 },
          "student_id": { "$ref": "common.schema.json#/$defs/student_id" },
          "name": { "type": "string" },

          "score": {
            "$ref": "common.schema.json#/$defs/unit_interval",
            "description": "Sum(strength x weight) / Sum(weight). Displayed as a percentage; stored in [0,1]."
          },
          "numerator":   { "type": "number", "minimum": 0 },
          "denominator": { "type": "number", "exclusiveMinimum": 0, "description": "Sum of weights of ALL JD skills, including ones with no evidence — otherwise missing skills would be free." },

          "skill_scores": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["skill_id", "skill_name", "requirement_level", "weight", "strength", "has_evidence"],
              "additionalProperties": false,
              "properties": {
                "skill_id":   { "$ref": "common.schema.json#/$defs/skill_id" },
                "skill_name": { "$ref": "common.schema.json#/$defs/skill_name" },
                "requirement_level": { "$ref": "common.schema.json#/$defs/requirement_level" },
                "weight":   { "type": "number", "minimum": 0 },
                "strength": { "$ref": "common.schema.json#/$defs/unit_interval", "description": "Aggregated evidence score across repos. 0 when has_evidence is false." },
                "has_evidence": { "type": "boolean", "description": "Distinguishes 'no evidence found' from 'evidence found and weak'." },
                "contribution": { "type": "number", "description": "strength x weight — the row's share of the numerator." },
                "contributing_repos": {
                  "type": "array",
                  "description": "Every repository that demonstrated the skill, kept even when only the max is used, so the breakdown stays inspectable.",
                  "items": {
                    "type": "object",
                    "required": ["repo_id", "repo_name", "confidence"],
                    "additionalProperties": false,
                    "properties": {
                      "repo_id":    { "$ref": "common.schema.json#/$defs/repo_id" },
                      "repo_name":  { "type": "string" },
                      "confidence": { "$ref": "common.schema.json#/$defs/unit_interval" },
                      "evidence":   { "type": "string" },
                      "selected":   { "type": "boolean", "description": "true for the repo the aggregation actually used." }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },

    "computed_at": { "$ref": "common.schema.json#/$defs/timestamp" }
  }
}
